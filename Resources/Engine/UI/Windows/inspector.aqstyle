.props-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    overflow: clip;
}

.props-frame {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.props-tabs {
    flex-direction: column;
    align-items: end;
    width: 30px;
    height: grow;
    gap: 2px;
    padding: 6px 0px;
    background-color: var(--bg-base);
}

.props-tab-separator {
    width: 16px;
    height: 1px;
    background-color: var(--border-dim);
}

.props-main {
    flex-direction: column;
    width: grow;
    height: grow;
    min-width: 0px;
}

.props-head {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 30px;
    gap: 6px;
    padding: 0px 8px 0px 10px;
}

.props-head-icon {
    width: 14px;
    height: 14px;
}

.props-name {
    width: grow;
    height: 22px;
    padding: 0px 4px;
    font-family: medium;
    font-size: var(--font-size-control);
    color: var(--text-bright);
    background-color: transparent;
    border-width: 0px;
}

.props-name:hover {
    background-color: var(--input-bg);
}

.props-uuid {
    font-family: mono;
    font-size: var(--font-size-caption);
    color: var(--text-muted);
}

.props-empty {
    flex-direction: column;
    width: 100%;
    height: grow;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.props-pages {
    flex-direction: column;
    width: 100%;
}

.inspector-empty-text {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    max-width: 240px;
    text-align: center;
    white-space: normal;
}

.asset-inspector-preview {
    width: 96px;
    height: 96px;
    color: #ffffff;
    border-radius: 4px;
}
