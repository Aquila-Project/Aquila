.launcher-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.launcher-screen {
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: grow;
    padding: 56px 16px 16px 16px;
}

.launcher-column {
    flex-direction: column;
    width: grow;
    max-width: 560px;
    height: grow;
}

.launcher-header {
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 10px;
}

.launcher-logo {
    width: 48px;
    height: 48px;
}

.launcher-brand {
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.launcher-title {
    font-family: medium;
    font-size: 20px;
    color: var(--text-bright);
}

.launcher-version {
    font-family: regular;
    font-size: 11px;
    color: var(--text-dim);
}

.launcher-home-body {
    flex-direction: column;
    width: 100%;
    height: grow;
    padding: 40px 0px 0px 0px;
    gap: 12px;
}

.launcher-tiles {
    flex-direction: row;
    width: 100%;
    gap: 8px;
}

.launcher-tile {
    flex-direction: row;
    align-items: center;
    width: grow;
    padding: 14px;
    gap: 12px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 6px;
    transition: 80ms ease-out;
}

.launcher-tile:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-lit);
}

.launcher-tile:pressed {
    background-color: var(--bg-muted);
}

.launcher-tile-icon {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background-color: var(--bg-widget);
    color: var(--text);
}

.launcher-tile-icon-accent {
    background-color: var(--accent-muted);
    color: var(--text-bright);
}

.launcher-tile-glyph {
    width: 16px;
    height: 16px;
}

.launcher-tile-text {
    flex-direction: column;
    width: grow;
    gap: 2px;
}

.launcher-tile-title {
    font-family: medium;
    font-size: 13px;
    color: var(--text);
}

.launcher-tile-hint {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.launcher-recent-section {
    flex-direction: column;
    width: 100%;
    height: grow;
    padding: 24px 0px 0px 0px;
}

.launcher-recent-header {
    width: 100%;
    padding: 0px 10px 8px 10px;
}

.launcher-section {
    font-family: bold;
    font-size: 14px;
    color: var(--text-dim);
}

.launcher-recent-scroll {
    width: 100%;
    height: grow;
}

.launcher-recent-list {
    flex-direction: column;
    width: 100%;
}

.launcher-recent {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 10px;
    gap: 12px;
    border-radius: 4px;
    transition: 60ms ease-out;
}

.launcher-recent:hover {
    background-color: var(--bg-panel);
}

.launcher-recent:pressed {
    background-color: var(--bg-muted);
}

.launcher-recent-text {
    flex-direction: column;
    width: grow;
    min-width: 0px;
    gap: 2px;
}

.launcher-recent-name {
    font-family: medium;
    font-size: 13px;
    color: var(--text);
}

.launcher-recent-path {
    font-family: mono;
    font-size: 11px;
    color: var(--text-dim);
    width: grow;
    min-width: 0px;
    white-space: nowrap;
    text-overflow: ellipsis-middle;
}

.launcher-recent-when {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    white-space: nowrap;
}

.launcher-empty {
    width: 100%;
    padding: 0px 10px;
}

.launcher-empty-text {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
}

.launcher-action-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    gap: 10px;
    background-color: var(--bg-panel);
    border-color: var(--border-lit);
    border-width: 1px;
    border-radius: 6px;
}

.launcher-action-label {
    font-family: regular;
    font-size: 13px;
    color: var(--text);
    width: grow;
}

.launcher-action-input {
    width: grow;
    max-width: 220px;
    min-width: 0px;
}

.launcher-primary {
    padding: 7px 16px;
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.launcher-primary:hover {
    background-color: var(--accent-muted);
}

.launcher-primary-disabled {
    opacity: 0.4;
}

.launcher-danger {
    background-color: #5a2a22;
    border-color: var(--danger);
}

.launcher-danger:hover {
    background-color: var(--danger);
}

.launcher-secondary {
    padding: 7px 16px;
    background-color: transparent;
    color: var(--text-dim);
    border-color: var(--border-lit);
    border-width: 1px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.launcher-secondary:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.launcher-footer {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    padding: 8px 0px 0px 0px;
}

.launcher-footer-button {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 0px 10px;
    gap: 6px;
    border-radius: 4px;
    color: var(--text-dim);
    transition: 60ms ease-out;
}

.launcher-footer-button:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.launcher-footer-icon {
    width: 13px;
    height: 13px;
}

.launcher-footer-label {
    font-family: regular;
    font-size: 12px;
}

.launcher-error {
    font-family: regular;
    font-size: 12px;
    color: var(--danger);
}

.launcher-back {
    position: absolute;
    left: 16px;
    top: 16px;
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding: 0px 10px 0px 6px;
    gap: 4px;
    border-radius: 4px;
    color: var(--text-dim);
    transition: 60ms ease-out;
}

.launcher-back:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.launcher-back-icon {
    width: 14px;
    height: 14px;
}

.launcher-back-label {
    font-family: regular;
    font-size: 12px;
}

.launcher-new-column {
    flex-direction: column;
    width: grow;
    max-width: 440px;
}

.launcher-new-header {
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 12px;
}

.launcher-new-logo {
    width: 40px;
    height: 40px;
}

.launcher-new-heading {
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.launcher-new-title {
    font-family: medium;
    font-size: 20px;
    color: var(--text-bright);
}

.launcher-new-subtitle {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.launcher-form {
    flex-direction: column;
    width: 100%;
    padding: 36px 0px 0px 0px;
    gap: 18px;
}

.launcher-field {
    flex-direction: column;
    width: 100%;
    gap: 6px;
}

.launcher-field-label {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.launcher-field-row {
    flex-direction: row;
    width: 100%;
    gap: 6px;
}

.launcher-input {
    width: grow;
    height: 36px;
    padding: 0px 12px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-radius: 6px;
    font-size: 13px;
}

.launcher-input:focus {
    border-color: var(--accent);
}

.launcher-input-mono {
    font-family: mono;
    font-size: 12px;
}

.launcher-input-invalid {
    border-color: var(--danger);
}

.launcher-input-invalid:focus {
    border-color: var(--danger);
}

.launcher-field-error {
    font-family: regular;
    font-size: 12px;
    color: var(--danger);
}

.launcher-browse {
    height: 36px;
    padding: 0px 14px;
    border-radius: 6px;
    background-color: var(--bg-widget);
    color: var(--text);
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.launcher-browse:hover {
    background-color: var(--bg-hover);
}

.launcher-preview {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    gap: 8px;
    border-radius: 6px;
    background-color: var(--bg-panel);
    color: var(--text-dim);
}

.launcher-preview-icon {
    width: 14px;
    height: 14px;
}

.launcher-preview-label {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    white-space: nowrap;
}

.launcher-preview-path {
    font-family: mono;
    font-size: 11px;
    color: var(--text);
    width: grow;
    min-width: 0px;
    white-space: nowrap;
    text-overflow: ellipsis-middle;
}

.launcher-new-actions {
    flex-direction: row;
    justify-content: end;
    width: 100%;
    padding: 10px 0px 0px 0px;
    gap: 8px;
}

.launcher-button {
    height: 34px;
    padding: 0px 16px;
    border-radius: 6px;
    background-color: var(--bg-widget);
    color: var(--text);
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.launcher-button:hover {
    background-color: var(--bg-hover);
}

.launcher-create {
    height: 34px;
    padding: 0px 16px;
    border-radius: 6px;
    background-color: var(--accent-muted);
    color: var(--text-bright);
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.launcher-create:hover {
    background-color: var(--accent);
}

.launcher-create-disabled {
    opacity: 0.45;
}

.launcher-create-disabled:hover {
    background-color: var(--accent-muted);
}
