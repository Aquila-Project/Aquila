.launcher-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.launcher-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 76px;
    padding: 0px 24px;
    gap: 14px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
}

.launcher-logo {
    width: 40px;
    height: 40px;
}

.launcher-brand {
    flex-direction: column;
    gap: 2px;
}

.launcher-title {
    font-family: medium;
    font-size: 22px;
    color: var(--text-bright);
}

.launcher-tagline {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
}

.launcher-header-fill {
    width: grow;
    height: 1px;
}

.launcher-version {
    font-family: regular;
    font-size: 13px;
    color: var(--text-muted);
}

.launcher-main {
    flex-direction: row;
    width: 100%;
    height: grow;
}

.launcher-rail {
    flex-direction: column;
    width: 200px;
    height: 100%;
    padding: 16px 12px;
    gap: 4px;
    background-color: var(--bg-deep);
    border-color: var(--border-ui);
    border-width: 1px;
}

.launcher-nav {
    width: 100%;
    justify-content: start;
    align-items: center;
    padding: 9px 12px;
    background-color: transparent;
    color: var(--text-dim);
    font-family: regular;
    font-size: 14px;
    border-radius: 4px;
    transition: 60ms ease-out;
}

.launcher-nav:hover {
    background-color: var(--bg-surface);
    color: var(--text-bright);
}

.launcher-nav-active {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.launcher-content {
    flex-direction: column;
    width: grow;
    height: 100%;
    padding: 24px;
}

.launcher-page {
    flex-direction: column;
    width: 100%;
    height: grow;
    gap: 12px;
}

.launcher-title-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 12px;
}

.launcher-page-title {
    font-family: medium;
    font-size: 20px;
    color: var(--text-bright);
}

.launcher-page-count {
    font-family: regular;
    font-size: 13px;
    color: var(--text-muted);
}

.launcher-section {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    padding: 6px 0px 0px 0px;
}

.launcher-grid-scroll {
    width: 100%;
    height: grow;
}

.launcher-grid {
    flex-direction: column;
    width: 100%;
    padding: 2px 8px 8px 2px;
    gap: 14px;
}

.launcher-row {
    flex-direction: row;
    width: 100%;
    gap: 14px;
}

.launcher-spacer {
    width: grow;
    height: 1px;
}

.launcher-card {
    flex-direction: column;
    width: grow;
    padding: 8px;
    gap: 10px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 6px;
    transition: 80ms ease-out;
}

.launcher-card:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-lit);
}

.launcher-card:pressed {
    background-color: var(--bg-muted);
}

.launcher-thumb {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96px;
    border-radius: 4px;
}

.launcher-thumb-letter {
    font-family: medium;
    font-size: 40px;
    color: var(--text-bright);
}

.launcher-thumb-0 {
    background-color: #2c4a35;
}

.launcher-thumb-1 {
    background-color: #2c3f4a;
}

.launcher-thumb-2 {
    background-color: #4a3b2c;
}

.launcher-thumb-3 {
    background-color: #3d2c4a;
}

.launcher-thumb-4 {
    background-color: #4a2c3a;
}

.launcher-thumb-5 {
    background-color: #4a462c;
}

.launcher-thumb-new {
    background-color: var(--bg-muted);
    border-color: var(--border-lit);
    border-width: 1px;
    border-style: dashed;
}

.launcher-card-body {
    flex-direction: column;
    width: 100%;
    gap: 3px;
}

.launcher-card-name {
    font-family: medium;
    font-size: 15px;
    color: var(--text-bright);
    overflow: hidden;
}

.launcher-card-meta {
    font-family: regular;
    font-size: 12px;
    color: var(--text-muted);
    overflow: hidden;
}

.launcher-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: grow;
    gap: 12px;
}

.launcher-empty-logo {
    width: 72px;
    height: 72px;
    opacity: 0.45;
}

.launcher-empty-title {
    font-family: medium;
    font-size: 18px;
    color: var(--text-bright);
}

.launcher-empty-hint {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    padding: 0px 0px 8px 0px;
}

.launcher-action-bar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    gap: 10px;
    background-color: var(--bg-panel);
    border-color: var(--border-lit);
    border-width: 1px;
    border-radius: 6px;
}

.launcher-action-label {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    width: grow;
}

.launcher-action-input {
    width: grow;
    max-width: 260px;
    min-width: 0px;
}

.launcher-template-row {
    flex-direction: row;
    width: 100%;
    gap: 14px;
}

.launcher-template {
    flex-direction: column;
    width: grow;
    padding: 12px;
    gap: 6px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 6px;
    transition: 80ms ease-out;
}

.launcher-template:hover {
    background-color: var(--bg-surface);
}

.launcher-template-selected {
    border-color: var(--accent);
    background-color: var(--accent-press);
}

.launcher-template-name {
    font-family: medium;
    font-size: 15px;
    color: var(--text-bright);
}

.launcher-template-desc {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
}

.launcher-name-input {
    width: 100%;
}

.launcher-hint {
    font-family: regular;
    font-size: 12px;
    color: var(--text-muted);
}

.launcher-error {
    font-family: regular;
    font-size: 13px;
    color: var(--danger);
}

.launcher-form-actions {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 8px 0px 0px 0px;
}

.launcher-primary {
    padding: 8px 18px;
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.launcher-primary:hover {
    background-color: var(--accent-muted);
}

.launcher-primary-disabled {
    opacity: 0.4;
}

.launcher-danger {
    background-color: #5a2a22;
    border-color: var(--danger);
}

.launcher-danger:hover {
    background-color: var(--danger);
}

.launcher-secondary {
    padding: 8px 18px;
    background-color: transparent;
    color: var(--text-dim);
    border-color: var(--border-lit);
    border-width: 1px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.launcher-secondary:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.launcher-tips {
    flex-direction: column;
    width: 100%;
    gap: 14px;
}

.launcher-tip {
    flex-direction: column;
    width: 100%;
    gap: 2px;
}

.launcher-tip-title {
    font-family: medium;
    font-size: 14px;
    color: var(--text-bright);
}

.launcher-tip-text {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
}

.launcher-link {
    flex-direction: column;
    width: 100%;
    padding: 12px 14px;
    gap: 4px;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 6px;
    transition: 80ms ease-out;
}

.launcher-link:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-lit);
}

.launcher-link:pressed {
    background-color: var(--bg-muted);
}

.launcher-link-url {
    font-family: regular;
    font-size: 12px;
    color: var(--accent);
}
