#console-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    background-color: var(--bg-deep);
}

#console-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 32px;
    padding: 0px 6px;
    gap: 6px;
    background-color: var(--bg-panel);
}

.console-clear-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    padding: 3px 8px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.console-clear-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.console-clear-btn:pressed {
    background-color: var(--bg-surface);
}

.console-toolbar-sep {
    width: 1px;
    height: 20px;
    background-color: var(--border-dim);
}

.console-filter-btn {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.console-filter-btn:hover {
    background-color: var(--bg-hover);
}

.console-filter-btn:pressed {
    background-color: var(--bg-surface);
}

.console-filter-icon {
    width: 14px;
    height: 14px;
}

.console-filter-count {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

#console-scroll {
    flex-direction: column;
    width: 100%;
    padding: 4px 0px;
}

.console-line {
    width: 100%;
    font-family: mono;
    font-size: 16px;
    color: var(--text-dim);
    padding: 1px 8px;
    overflow: hidden;
}

.console-info {
    color: var(--text-dim);
}

.console-debug {
    color: var(--text-muted);
}

.console-trace {
    color: var(--text-muted);
}

.console-warning {
    color: #c9a24a;
}

.console-error {
    color: var(--danger);
}

.console-critical {
    color: #ff5555;
}
