#content-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#content-scroll {
    width: 100%;
    height: grow;
}

.content-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 4px;
    padding: 6px 6px 4px 6px;
}

.content-tool-btn {
    width: 24px;
    height: 24px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.content-tool-btn:hover {
    background-color: var(--bg-hover);
}

.content-path {
    flex-direction: row;
    align-items: center;
    width: grow;
    gap: 2px;
}

.content-crumb {
    font-size: 12px;
    color: var(--text-dim);
    min-height: 22px;
    padding: 0px 6px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.content-crumb:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.content-crumb-current {
    color: var(--text);
}

.content-crumb-separator {
    width: 12px;
    height: 12px;
    color: var(--text-muted);
}

.content-filter {
    width: grow;
    max-width: 160px;
    min-width: 0px;
    height: 24px;
    font-size: 12px;
}

.content-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    gap: 4px;
    padding: 4px 8px 8px 8px;
}

.content-tile {
    flex-direction: column;
    align-items: center;
    width: 88px;
    padding: 10px 4px 8px 4px;
    gap: 6px;
    border-radius: 4px;
    background-color: transparent;
    transition: 60ms linear;
}

.content-tile:hover {
    background-color: var(--bg-hover);
}

.content-tile-selected {
    background-color: var(--selection);
}

.content-tile-preview {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
}

.content-tile-icon {
    width: 36px;
    height: 36px;
    color: var(--text-dim);
}

.content-tile-thumbnail {
    color: #ffffff;
    border-radius: 2px;
}

.content-tile-folder {
    color: #c9a64e;
}

.content-tile-badge {
    position: absolute;
    left: 5px;
    bottom: 5px;
    padding: 1px 4px;
    border-radius: 3px;
    font-family: mono;
    font-size: 9px;
    white-space: nowrap;
    color: var(--text);
    background-color: var(--bg-surface);
}

.content-tile-badge-script {
    color: #8cbbff;
    background-color: #2c343e;
}

.content-tile-badge-material {
    color: #e6d3ae;
    background-color: #3b3833;
}

.content-tile-badge-model {
    color: #b4c3d8;
    background-color: #313439;
}

.content-tile-name {
    font-family: regular;
    font-size: 12px;
    color: var(--text);
    white-space: normal;
    text-align: center;
}

.content-tile-rename {
    width: 100%;
    height: 20px;
    padding: 0px 4px;
    font-family: regular;
    font-size: 12px;
}

.content-empty {
    font-family: regular;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px;
}
