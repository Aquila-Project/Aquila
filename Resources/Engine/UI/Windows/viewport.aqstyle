#viewport-image {
    width: grow;
    height: grow;
    flex-grow: 1;
}

.viewport-root {
    width: grow;
    height: grow;
    flex-direction: column;
}

.viewport-canvas {
    overflow: hidden;
}

.viewport-canvas-layer {
    width: 100%;
    height: 100%;
    font-family: mono;
    font-size: 12px;
}
