<Import src="../Components/overlay"/>

<View id="viewport-root" class="viewport-root">
    <Image id="viewport-image"/>
    <OverlayToolbar id="viewport-transform-tools" edge="left" along="8">
        <Button id="tool-translate" class="overlay-tool" src="Engine/UI/Icons/move-3d.svg" tooltip="Move (W)"/>
        <Button id="tool-rotate" class="overlay-tool" src="Engine/UI/Icons/rotate-3d.svg" tooltip="Rotate (E)"/>
        <Button id="tool-scale" class="overlay-tool" src="Engine/UI/Icons/scale-3d.svg" tooltip="Scale (R)"/>
        <Separator/>
        <Button id="tool-space" class="overlay-tool" src="Engine/UI/Icons/globe.svg" tooltip="World space (click for local)"/>
        <Button id="tool-snap" class="overlay-tool" src="Engine/UI/Icons/magnet.svg" tooltip="Snapping: 0.5 m, 15°, 0.1 scale (hold Ctrl to invert)"/>
    </OverlayToolbar>
    <OverlayToolbar id="viewport-view-tools" edge="top" along="52">
        <Dropdown id="viewport-shading" tooltip="Shading"/>
        <Separator/>
        <View id="viewport-show" class="overlay-menu">
            <Button id="viewport-show-button" class="overlay-tool" src="Engine/UI/Icons/eye.svg" tooltip="Show"/>
            <Popover id="viewport-show-popover" title="Show">
                <OverlayCheckRow id="show-grid" label="Grid"/>
                <OverlayCheckRow id="show-sky" label="Sky"/>
                <OverlayCheckRow id="show-shadows" label="Shadows"/>
                <OverlayCheckRow id="show-outline" label="Selection Outline"/>
                <OverlayCheckRow id="show-realtime" label="Realtime"/>
                <PopoverTitle title="Overlays"/>
                <OverlayCheckRow id="overlay-axis-widget" label="Axis Widget"/>
                <OverlayCheckRow id="overlay-selection-label" label="Selection Label"/>
                <OverlayCheckRow id="overlay-safe-frame" label="Safe Frame"/>
                <OverlayCheckRow id="overlay-render-status" label="Render Status"/>
                <OverlayCheckRow id="overlay-statistics" label="Statistics"/>
                <OverlayCheckRow id="overlay-gpu-timings" label="GPU Timings"/>
            </Popover>
        </View>
        <View id="viewport-camera" class="overlay-menu">
            <Button id="viewport-camera-button" class="overlay-tool" src="Engine/UI/Icons/video.svg" tooltip="Camera"/>
            <Popover id="viewport-camera-popover" title="Camera" class="overlay-popover-wide">
                <PropertyGrid id="camera-grid" split="true"/>
            </Popover>
        </View>
    </OverlayToolbar>
    <ViewportOverlay id="viewport-overlay"/>
    <TransformGizmo id="viewport-gizmo"/>
</View>
