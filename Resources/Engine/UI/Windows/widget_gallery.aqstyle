.gallery-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.gallery-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 30px;
    padding: 0px 12px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.gallery-title {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.gallery-scroll {
    width: 100%;
    height: grow;
}

.gallery-content {
    flex-direction: column;
    width: 100%;
    padding: 12px;
    gap: 14px;
}

.gallery-item {
    flex-direction: column;
    width: 100%;
    gap: 5px;
}

.gallery-heading {
    font-family: regular;
    font-size: 14px;
    color: var(--accent-muted);
}

.gallery-tabview {
    height: 150px;
}

.gallery-listbox {
    height: 108px;
}

.gallery-image {
    width: 32px;
    height: 32px;
}
