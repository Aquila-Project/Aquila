<Component name="LauncherRecent" props="name path when">
    <Clickable class="launcher-recent">
        <View class="launcher-recent-text">
            <Label class="launcher-recent-name">$name</Label>
            <Label class="launcher-recent-path">$path</Label>
        </View>
        <Label class="launcher-recent-when">$when</Label>
    </Clickable>
</Component>

<View id="launcher-root" class="launcher-root">
    <View id="launcher-page-home" class="launcher-screen">
        <View class="launcher-column">
            <View class="launcher-header">
                <Image class="launcher-logo" src="Engine/aquila-logo.png"/>
                <View class="launcher-brand">
                    <Label class="launcher-title">Aquila</Label>
                    <Label id="launcher-version" class="launcher-version"/>
                </View>
            </View>

            <View class="launcher-home-body">
                <View class="launcher-tiles">
                    <Clickable id="launcher-new-tile" class="launcher-tile">
                        <View class="launcher-tile-icon launcher-tile-icon-accent">
                            <Image class="launcher-tile-glyph" src="Engine/UI/Icons/plus.svg"/>
                        </View>
                        <View class="launcher-tile-text">
                            <Label class="launcher-tile-title">New Project</Label>
                            <Label class="launcher-tile-hint">Create a project folder</Label>
                        </View>
                    </Clickable>
                    <Clickable id="launcher-open-tile" class="launcher-tile">
                        <View class="launcher-tile-icon">
                            <Image class="launcher-tile-glyph" src="Engine/UI/Icons/folder.svg"/>
                        </View>
                        <View class="launcher-tile-text">
                            <Label class="launcher-tile-title">Open Project...</Label>
                            <Label class="launcher-tile-hint">Browse for an existing project</Label>
                        </View>
                    </Clickable>
                </View>
                <Label id="launcher-open-error" class="launcher-error hidden"/>

                <View class="launcher-recent-section">
                    <View class="launcher-recent-header">
                        <Label class="launcher-section">RECENT</Label>
                    </View>
                    <ScrollView id="launcher-recent-scroll" class="launcher-recent-scroll">
                        <View id="launcher-recent" class="launcher-recent-list"/>
                    </ScrollView>
                    <View id="launcher-empty" class="launcher-empty">
                        <Label class="launcher-empty-text">No projects yet. Create one to get started.</Label>
                    </View>
                </View>

                <View id="launcher-action-bar" class="launcher-action-bar hidden">
                    <Label id="launcher-action-label" class="launcher-action-label"/>
                    <TextInput id="launcher-action-input" class="launcher-action-input" placeholder="Project name"/>
                    <Button id="launcher-action-confirm" class="launcher-primary">Confirm</Button>
                    <Button id="launcher-action-cancel" class="launcher-secondary">Cancel</Button>
                </View>
            </View>

            <View class="launcher-footer">
                <Clickable id="launcher-docs" class="launcher-footer-button">
                    <Image class="launcher-footer-icon" src="Engine/UI/Icons/book-open-text.svg"/>
                    <Label class="launcher-footer-label">Documentation</Label>
                </Clickable>
                <Clickable id="launcher-git" class="launcher-footer-button">
                    <Image class="launcher-footer-icon" src="Engine/UI/Icons/git-branch.svg"/>
                    <Label class="launcher-footer-label">Aquila Repository</Label>
                </Clickable>

            </View>
        </View>
    </View>

    <View id="launcher-page-new" class="launcher-screen hidden">
        <Clickable id="launcher-new-back" class="launcher-back">
            <Image class="launcher-back-icon" src="Engine/UI/Icons/chevron-left.svg"/>
            <Label class="launcher-back-label">Back</Label>
        </Clickable>
        <View class="launcher-new-column">
            <View class="launcher-new-header">
                <Image class="launcher-new-logo" src="Engine/aquila-logo.png"/>
                <View class="launcher-new-heading">
                    <Label class="launcher-new-title">New Project</Label>
                    <Label class="launcher-new-subtitle">Name it and choose where it lives.</Label>
                </View>
            </View>

            <View class="launcher-form">
                <View class="launcher-field">
                    <Label class="launcher-field-label">Project name</Label>
                    <TextInput id="launcher-name" class="launcher-input" placeholder="My project"/>
                    <Label id="launcher-name-error" class="launcher-field-error hidden"/>
                </View>

                <View class="launcher-field">
                    <Label class="launcher-field-label">Location</Label>
                    <View class="launcher-field-row">
                        <TextInput id="launcher-location" class="launcher-input launcher-input-mono"/>
                        <Button id="launcher-browse" class="launcher-browse">Browse...</Button>
                    </View>
                    <Label id="launcher-location-error" class="launcher-field-error hidden"/>
                </View>

                <View class="launcher-preview">
                    <Image class="launcher-preview-icon" src="Engine/UI/Icons/folder.svg"/>
                    <Label class="launcher-preview-label">Creates</Label>
                    <Label id="launcher-preview" class="launcher-preview-path"/>
                </View>

                <Label id="launcher-error" class="launcher-field-error hidden"/>
                <View class="launcher-new-actions">
                    <Button id="launcher-cancel" class="launcher-button">Cancel</Button>
                    <Button id="launcher-create" class="launcher-create">Create Project</Button>
                </View>
            </View>
        </View>
    </View>

    <PopupMenu id="launcher-menu">
        <MenuItem action="open" label="Open"/>
        <MenuItem action="rename" label="Rename"/>
        <MenuItem action="delete" label="Delete"/>
    </PopupMenu>
    <PopupMenu id="launcher-external-menu">
        <MenuItem action="open" label="Open"/>
        <MenuItem action="rename" label="Rename"/>
        <MenuItem action="forget" label="Remove from list"/>
    </PopupMenu>
</View>
