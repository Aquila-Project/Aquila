#root {
    width: grow;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-base);
}

#workspace {
    width: 100%;
    height: grow;
    flex-direction: column;
}

#dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
}

.hud-status {
    flex-direction: row;
    align-items: center;
    width: 100vw;
    min-height: 24px;
    padding: 0px 12px;
    gap: 16px;
    background-color: var(--bg-deep);
    border-width: 0px;
}

.status-spacer {
    width: grow;
}

.status-item {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.status-selection {
    font-family: regular;
    font-size: 12px;
    color: var(--text);
}

.status-key {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.status-value {
    font-family: regular;
    font-size: 12px;
    color: var(--text-bright);
}

.topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 36px;
    padding: 0px 6px;
    gap: 2px;
    background-color: var(--bg-deep);
}

.topbar-btn {
    width: 28px;
    height: 28px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms linear;
}

.topbar-btn:hover {
    background-color: var(--bg-hover);
}

.topbar-btn:disabled {
    opacity: 0.4;
}

.topbar-btn-active {
    background-color: var(--accent-dark);
}

.topbar-btn-active:hover {
    background-color: var(--accent-muted);
}

.topbar-sep {
    width: 1px;
    height: 18px;
    background-color: var(--hairline);
}

.topbar-spacer {
    width: grow;
}

.workspace-tabs {
    flex-direction: row;
    align-items: center;
    height: 100%;
    gap: 2px;
    padding: 0px 4px;
}

.workspace-tab {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    min-height: 26px;
    padding: 0px 12px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms linear;
}

.workspace-tab:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.workspace-tab-active {
    background-color: var(--bg-panel);
    color: var(--text-bright);
}

.dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
    padding: 0px 2px 2px 2px;
    background-color: var(--bg-deep);
}

.play-tint {
    background-color: var(--play-tint);
}
