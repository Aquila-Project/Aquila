.dock-space {
    width: 100%;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--bg-deep);
}

.dock-node {
    width: grow;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
}

.dock-split {
    gap: 2px;
    background-color: var(--bg-deep);
}

.dock-leaf {
    background-color: var(--bg-panel);
    border-radius: 4px;
    overflow: hidden;
}

.dock-tab-bar {
    width: 100%;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-base);
}

.dock-tab-strip {
    width: grow;
    height: 100%;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.dock-tab-actions {
    height: 100%;
    flex-direction: row;
    align-items: center;
    gap: 1px;
    padding: 0px 4px;
}

.dock-tab-action {
    width: 22px;
    height: 22px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 3px;
    opacity: 0.6;
    transition: 60ms linear;
}

.dock-tab-action:hover {
    background-color: var(--bg-hover);
    opacity: 1;
}

.dock-tab-wrapper {
    flex-direction: row;
    height: 100%;
    align-items: center;
    padding: 0px 4px 0px 0px;
}

.dock-tab-wrapper:hover {
    background-color: var(--bg-muted);
}

.dock-tab-active {
    background-color: var(--bg-panel);
}

.dock-tab-btn {
    font-family: regular;
    font-size: 13px;
    color: var(--text-muted);
    padding: 0px 8px 0px 10px;
    height: 100%;
    min-width: 0px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    transition: 60ms linear;
}

.dock-tab-btn:hover {
    color: var(--text);
}

.dock-tab-btn-active {
    color: var(--text-bright);
}

.dock-tab-close-btn {
    width: 18px;
    height: 18px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 3px;
    opacity: 0.45;
    transition: 60ms linear;
}

.dock-tab-close-btn:hover {
    background-color: var(--bg-hover);
    opacity: 1;
}

.dock-node-empty {
    align-items: center;
    justify-content: center;
}

.dock-panel {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-panel-area {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-splitter {
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.dock-splitter-h {
    width: 6px;
    height: 100%;
    cursor: resize-h;
}

.dock-splitter-v {
    width: 100%;
    height: 6px;
    cursor: resize-v;
}

.dock-grabber {
    background-color: var(--accent);
    border-radius: 1px;
}

.dock-grabber-h {
    width: 2px;
    height: 100%;
}

.dock-grabber-v {
    width: 100%;
    height: 2px;
}

.dock-drop-target {
    background-color: var(--drop-target);
}

.dock-drop-preview {
    background-color: var(--drop-overlay);
    border-color: var(--accent);
    border-width: 2px;
    border-radius: 3px;
}

.dock-zone-indicator {
    width: 36px;
    height: 36px;
    background-color: var(--bg-surface);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 3px;
    opacity: 0.9;
    transition: 80ms ease-out;
}

.dock-zone-center-ind {
    width: 40px;
    height: 40px;
}

.dock-zone-indicator-active {
    background-color: var(--accent);
    border-color: var(--accent);
    opacity: 1;
}

@container (max-width: 220px) {
    .dock-tab-btn {
        padding: 0px 6px;
    }
}
