:root {
    --bg-deep: #101010;
    --bg-base: #171717;
    --bg-panel: #1f1f1f;
    --bg-muted: #252525;
    --bg-surface: #2d2d2d;
    --bg-widget: #323232;
    --bg-hover: #3c3c3c;

    --bg-lit: #454545;

    --border: #131313;
    --border-ui: #2f2f2f;
    --border-dim: #3a3a3a;
    --border-lit: #4a4a4a;

    --text: #e6e6e6;
    --text-dim: #9e9e9e;
    --text-muted: #686868;
    --text-bright: #f4f4f4;

    --context-menu-bg: #1f1f1f;
    --context-menu-item: transparent;
    --context-menu-item-hover: #3c3c3c;
    --context-menu-item-press: #2d2d2d;

    --accent: #4a9e5f;
    --accent-dark: #2c4a35;
    --accent-press: #23382a;
    --accent-muted: #3d7a4e;
    --play-tint: #1c2c20;

    --danger: #e05a40;
    --success: #4ab870;

    --input-bg: #101010;
    --input-border: #2f2f2f;

    --danger-press: rgba(255, 80, 80, 0.35);

    --selection: #4a9e5f45;
    --drop-target: rgba(74, 158, 95, 0.06);
    --drop-overlay: rgba(74, 158, 95, 0.18);
    --drop-overlay-active: rgba(74, 158, 95, 0.55);

    --row-warning: rgba(180, 140, 40, 0.08);
    --row-error: rgba(180, 70, 70, 0.10);
    --row-critical: rgba(220, 50, 50, 0.14);

    --hairline: rgba(255, 255, 255, 0.08);
    --line-inset: rgba(0, 0, 0, 0.35);
    --line-soft: rgba(255, 255, 255, 0.07);

    --axis-x: #7A2222;
    --axis-y: #226622;
    --axis-z: #224488;
    --axis-x-hover: #CC5555;
    --axis-y-hover: #55AA55;
    --axis-z-hover: #4A80D4;

    --shadow-sm: 0px 2px 6px 0px rgba(0,0,0,0.45);
    --shadow-pop: 0px 6px 22px 0px rgba(0,0,0,0.55);
}

.hidden {
    display: none;
}

.dimmed {
    opacity: 0.35;
}
