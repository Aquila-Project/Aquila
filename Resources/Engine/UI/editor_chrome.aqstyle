#root {
    width: grow;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-base);
}

#hierarchy-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#hierarchy-scroll {
    width: 100%;
    height: grow;
}

.hierarchy-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 4px;
    padding: 6px 6px 4px 6px;
}

.hierarchy-filter {
    width: grow;
    height: 24px;
    font-size: 12px;
}

.hierarchy-tool-btn {
    width: 24px;
    height: 24px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.hierarchy-tool-btn:hover {
    background-color: var(--bg-hover);
}

.hierarchy-group-header {
    font-size: 11px;
    color: var(--text-muted);
    min-height: 26px;
}

.hierarchy-group-header:hover {
    color: var(--text-dim);
}

.hierarchy-group-count {
    font-family: mono;
    font-size: 11px;
    color: var(--text-muted);
    padding: 0px 6px 0px 0px;
}

.hierarchy-eye {
    width: 22px;
    height: 22px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 3px;
    transition: 60ms linear;
}

.hierarchy-eye:hover {
    background-color: var(--bg-hover);
}

.hierarchy-eye-shown {
    background-color: transparent;
}

.hierarchy-entity-hidden {
    color: var(--text-muted);
}

.hierarchy-drop-target {
    background-color: var(--drop-overlay);
}

#content-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#content-scroll {
    width: 100%;
    height: grow;
}

.content-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 4px;
    padding: 6px 6px 4px 6px;
}

.content-tool-btn {
    width: 24px;
    height: 24px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.content-tool-btn:hover {
    background-color: var(--bg-hover);
}

.content-path {
    flex-direction: row;
    align-items: center;
    width: grow;
    gap: 2px;
}

.content-crumb {
    font-size: 12px;
    color: var(--text-dim);
    min-height: 22px;
    padding: 0px 6px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.content-crumb:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.content-crumb-current {
    color: var(--text);
}

.content-crumb-separator {
    width: 12px;
    height: 12px;
    color: var(--text-muted);
}

.content-filter {
    width: grow;
    max-width: 160px;
    min-width: 0px;
    height: 24px;
    font-size: 12px;
}

.content-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    gap: 4px;
    padding: 4px 8px 8px 8px;
}

.content-tile {
    flex-direction: column;
    align-items: center;
    width: 88px;
    padding: 10px 4px 8px 4px;
    gap: 6px;
    border-radius: 4px;
    background-color: transparent;
    transition: 60ms linear;
}

.content-tile:hover {
    background-color: var(--bg-hover);
}

.content-tile-selected {
    background-color: var(--selection);
}

.content-tile-preview {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
}

.content-tile-icon {
    width: 36px;
    height: 36px;
    color: var(--text-dim);
}

.content-tile-thumbnail {
    color: #ffffff;
    border-radius: 2px;
}

.content-tile-folder {
    color: #c9a64e;
}

.content-tile-name {
    font-family: regular;
    font-size: 12px;
    color: var(--text);
    white-space: normal;
    text-align: center;
}

.content-tile-rename {
    width: 100%;
    height: 20px;
    padding: 0px 4px;
    font-family: regular;
    font-size: 12px;
}

.content-empty {
    font-family: regular;
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px;
}

#toolbar {
    width: 100%;
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-deep);
    padding: 0px 6px;
    gap: 0px;
}

#toolbar-left {
    flex-direction: row;
    align-items: center;
    gap: 0px;
    width: grow;
}

#engine-logo {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
    padding: 4px 10px;
}

#image-logo {
    width: 32px;
    height: 32px;
}

.menu-bar {
    gap: 2px;
}

.menu-bar-item {
    font-family: regular;
    font-size: 16px;
    color: var(--text-dim);
    padding: 4px 10px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
    background-color: var(--bg-deep);
    border-width: 0px;
    border-radius: 4px;
}

.menu-bar-item:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.menu-bar-item:pressed {
    background-color: var(--bg-surface);
    color: var(--text);
}

#workspace {
    width: 100%;
    height: grow;
    flex-direction: column;
}

#dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
}

#viewport-image {
    width: grow;
    height: grow;
    flex-grow: 1;
}

#console-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    background-color: var(--bg-deep);
}

#console-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 32px;
    padding: 0px 6px;
    gap: 6px;
    background-color: var(--bg-panel);
}

.console-clear-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    padding: 3px 8px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.console-clear-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.console-clear-btn:pressed {
    background-color: var(--bg-surface);
}

.console-toolbar-sep {
    width: 1px;
    height: 20px;
    background-color: var(--border-dim);
}

.console-filter-btn {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.console-filter-btn:hover {
    background-color: var(--bg-hover);
}

.console-filter-btn:pressed {
    background-color: var(--bg-surface);
}

.console-filter-icon {
    width: 14px;
    height: 14px;
}

.console-filter-count {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

#console-scroll {
    flex-direction: column;
    width: 100%;
    padding: 4px 0px;
}

.console-line {
    width: 100%;
    font-family: mono;
    font-size: 16px;
    color: var(--text-dim);
    padding: 1px 8px;
    overflow: hidden;
}

.console-info {
    color: var(--text-dim);
}

.console-debug {
    color: var(--text-muted);
}

.console-trace {
    color: var(--text-muted);
}

.console-warning {
    color: #c9a24a;
}

.console-error {
    color: var(--danger);
}

.console-critical {
    color: #ff5555;
}

.props-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    overflow: clip;
}

.props-frame {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.props-tabs {
    flex-direction: column;
    align-items: end;
    width: 30px;
    height: grow;
    gap: 2px;
    padding: 6px 0px;
    background-color: var(--bg-base);
}

.props-tab {
    width: 24px;
    height: 24px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px 0px 0px 4px;
    color: var(--text-dim);
    transition: 60ms ease-out;
}

.props-tab:hover {
    background-color: var(--bg-muted);
    color: var(--text-bright);
}

.props-tab-active {
    width: 27px;
    background-color: var(--bg-panel);
    color: var(--text-bright);
}

.props-tab-separator {
    width: 16px;
    height: 1px;
    background-color: var(--border-dim);
}

.props-main {
    flex-direction: column;
    width: grow;
    height: grow;
    min-width: 0px;
}

.props-head {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 30px;
    gap: 6px;
    padding: 0px 8px 0px 10px;
}

.props-head-icon {
    width: 14px;
    height: 14px;
}

.props-name {
    width: grow;
    height: 22px;
    padding: 0px 4px;
    font-family: medium;
    font-size: 13px;
    color: var(--text-bright);
    background-color: transparent;
    border-width: 0px;
}

.props-name:hover {
    background-color: var(--input-bg);
}

.props-uuid {
    font-family: mono;
    font-size: 11px;
    color: var(--text-muted);
}

.props-empty {
    flex-direction: column;
    width: 100%;
    height: grow;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.props-pages {
    flex-direction: column;
    width: 100%;
}

.props-page {
    flex-direction: column;
    width: 100%;
    gap: 6px;
    padding: 0px 8px 10px 6px;
}

.props-sections {
    flex-direction: column;
    width: 100%;
    gap: 4px;
}

.props-panel {
    flex-direction: column;
    width: 100%;
    background-color: var(--bg-base);
    border-radius: 4px;
    overflow: hidden;
}

.props-panel-header {
    min-height: 26px;
    padding: 0px 2px 0px 0px;
    background-color: transparent;
}

.props-panel-chevron {
    width: 20px;
    height: 100%;
    padding: 0px 0px 0px 4px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    color: var(--text-dim);
}

.props-panel-chevron:hover {
    color: var(--text-bright);
    background-color: transparent;
}

.props-panel-title {
    height: 100%;
    gap: 6px;
    padding: 0px 6px 0px 2px;
    font-family: medium;
    font-size: 12px;
    color: var(--text);
    background-color: transparent;
}

.props-panel-title:hover {
    color: var(--text-bright);
}

.props-panel-grip {
    width: 14px;
    color: var(--text-muted);
}

.props-panel-content {
    flex-direction: column;
    width: 100%;
    gap: 4px;
    padding: 2px 8px 8px 8px;
    background-color: transparent;
    border-width: 0px;
}

.props-add-component {
    width: 100%;
    min-height: 24px;
    gap: 6px;
    padding: 0px 8px;
    justify-content: start;
    font-family: regular;
    font-size: 12px;
    color: var(--text);
    background-color: var(--bg-surface);
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms ease-out;
}

.props-add-component:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.props-add-component:pressed {
    background-color: var(--bg-muted);
}

.props-dropdown {
    min-height: 20px;
    min-width: 0px;
}

.props-dropdown-header {
    min-height: 20px;
    gap: 6px;
    padding: 0px 6px;
    font-family: regular;
    font-size: 12px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 4px;
}

.props-dropdown-header:hover {
    background-color: var(--bg-muted);
    border-color: var(--border-lit);
}

.inspector-empty-text {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    max-width: 240px;
    text-align: center;
    white-space: normal;
}

.settings-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.settings-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 40px;
    padding: 4px 12px;
    gap: 10px;
    flex-wrap: wrap;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.settings-header-icon {
    width: 16px;
    height: 16px;
    color: var(--text-dim);
}

.settings-title {
    font-family: medium;
    font-size: 15px;
    color: var(--text-bright);
}

.settings-scopes {
    flex-direction: row;
    gap: 2px;
    padding: 2px;
    border-radius: 4px;
    background-color: var(--bg-base);
}

.settings-scope {
    min-height: 22px;
    padding: 0px 12px;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0px;
    border-radius: 3px;
    transition: 60ms ease-out;
}

.settings-scope:hover {
    color: var(--text-bright);
    background-color: var(--bg-hover);
}

.settings-scope-active {
    color: var(--text-bright);
    background-color: var(--bg-widget);
}

.settings-search {
    flex-direction: row;
    align-items: center;
    width: grow;
    min-width: 120px;
    max-width: 320px;
    min-height: 24px;
    padding: 0px 8px;
    gap: 6px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 4px;
}

.settings-search-icon {
    width: 13px;
    height: 13px;
    color: var(--text-muted);
}

.settings-search-input {
    width: grow;
    height: 22px;
    padding: 0px;
    font-size: 12px;
    background-color: transparent;
    border-width: 0px;
}

.settings-body {
    flex-direction: row;
    width: 100%;
    height: grow;
    overflow: hidden;
}

.settings-sidebar {
    width: 176px;
    height: grow;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.settings-nav {
    flex-direction: column;
    width: 100%;
    padding: 8px 6px;
    gap: 2px;
}

.settings-nav-item {
    width: 100%;
    min-height: 26px;
    gap: 8px;
    padding: 0px 8px;
    justify-content: start;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms ease-out;
}

.settings-nav-item:hover {
    color: var(--text-bright);
    background-color: var(--bg-hover);
}

.settings-nav-item-active {
    color: var(--text-bright);
    background-color: var(--selection);
}

.settings-main {
    flex-direction: column;
    width: grow;
    height: grow;
    min-width: 0px;
}

.settings-scroll {
    width: 100%;
    height: grow;
}

.settings-content {
    flex-direction: column;
    width: 100%;
    padding: 14px 18px 18px 18px;
    gap: 18px;
}

.settings-section {
    flex-direction: column;
    width: 100%;
    gap: 6px;
}

.settings-page-title {
    font-family: medium;
    font-size: 16px;
    color: var(--text-bright);
}

.settings-section-title {
    font-family: medium;
    font-size: 13px;
    color: var(--text-bright);
}

.settings-page-description {
    font-family: regular;
    font-size: 12px;
    color: var(--text-muted);
}

.settings-grid {
    padding: 6px 0px;
}

.settings-reset {
    min-height: 24px;
    padding: 0px 12px;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    background-color: var(--bg-widget);
    border-width: 0px;
    border-radius: 4px;
}

.settings-reset:hover {
    color: var(--text-bright);
    background-color: var(--bg-hover);
}

.settings-empty {
    font-family: regular;
    font-size: 13px;
    color: var(--text-muted);
}

.settings-shortcut-group {
    padding: 8px 0px 0px 0px;
    font-family: medium;
    font-size: 11px;
    color: var(--text-muted);
}

.settings-shortcut-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 26px;
    gap: 8px;
    padding: 0px 2px;
    flex-wrap: wrap;
}

.settings-shortcut-title {
    width: grow;
    min-width: 0px;
    font-family: regular;
    font-size: 12px;
    color: var(--text);
}

.settings-chord {
    min-width: 120px;
    min-height: 22px;
    padding: 0px 10px;
    font-family: mono;
    font-size: 12px;
    color: var(--text-bright);
    background-color: var(--bg-surface);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 4px;
}

.settings-chord:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-lit);
}

.settings-chord-empty {
    color: var(--text-muted);
}

.settings-chord-capturing {
    color: var(--text-bright);
    background-color: var(--accent-dark);
    border-color: var(--accent);
}

.settings-chord-reset {
    width: 22px;
    height: 22px;
    padding: 0px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
}

.settings-chord-reset:hover {
    color: var(--text-bright);
    background-color: var(--bg-hover);
}

.settings-shortcut-clash {
    padding: 0px 2px;
    font-family: regular;
    font-size: 11px;
    color: var(--danger);
}

.settings-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    min-height: 40px;
    padding: 6px 12px;
    gap: 8px;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.settings-footer-note {
    width: grow;
    min-width: 0px;
    font-family: regular;
    font-size: 11px;
    color: var(--text-muted);
}

.settings-btn {
    padding: 4px 16px;
    font-size: 12px;
    background-color: var(--bg-widget);
    color: var(--text);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.settings-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.settings-btn:pressed {
    background-color: var(--bg-surface);
}

@media (max-width: 500px) {
    #toolbar {
        min-height: 36px;
        padding: 0px 4px;
    }

    #engine-logo {
        padding: 3px 6px;
        font-size: 14px;
    }
}

.card {
    flex-direction: column;
    width: 100%;
    height: grow;
    min-height: 0px;
    background-color: var(--bg-base);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
    overflow: hidden;
}

.collapsed {
    height: auto;
}

.card-console {
    width: 60vw;
    height: 260px;
}

.card-header {
    min-height: 30px;
    padding: 0px 4px 0px 2px;
    background-color: transparent;
}

.card-title {
    background-color: transparent;
    font-size: 13px;
    color: var(--text-bright);
    padding: 0px 6px;
}

.card-content {
    height: grow;
    min-height: 0px;
    padding: 2px 6px 6px 6px;
    gap: 4px;
    background-color: transparent;
    border-width: 0px;
}

.collapsible-action {
    width: 24px;
    height: 24px;
    padding: 0px;
    background-color: transparent;
    border-radius: 4px;
}

.collapsible-action:hover {
    background-color: var(--bg-hover);
}

.hierarchy-toolbar-btn {
    width: grow;
    height: 26px;
    background-color: var(--bg-muted);
    border-radius: 4px;
}

.hud-round {
    width: 32px;
    height: 32px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-deep);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
}

.hud-round:hover {
    background-color: var(--bg-hover);
}

.hud-round:pressed {
    background-color: var(--bg-surface);
}

.component {
    flex-direction: column;
    width: 100%;
    background-color: var(--bg-muted);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
    overflow: hidden;
}

.component-header {
    min-height: 28px;
    padding: 0px 2px 0px 2px;
    background-color: transparent;
}

.component-title {
    background-color: transparent;
    font-size: 13px;
    color: var(--text-bright);
    padding: 0px 6px;
}

.component-content {
    padding: 2px 8px 8px 8px;
    gap: 6px;
    background-color: transparent;
    border-width: 0px;
}

.hud-status {
    flex-direction: row;
    align-items: center;
    width: 100vw;
    min-height: 24px;
    padding: 0px 12px;
    gap: 16px;
    background-color: var(--bg-deep);
    border-width: 0px;
}

.status-spacer {
    width: grow;
}

.status-item {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.status-selection {
    font-family: regular;
    font-size: 12px;
    color: var(--text);
}

.status-key {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.status-value {
    font-family: regular;
    font-size: 12px;
    color: var(--text-bright);
}

.selectable-text-view {
    width: grow;
    font-family: mono;
    font-size: 14px;
    color: var(--text);
    cursor: text;
    selection-color: var(--selection);
}

.topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 36px;
    padding: 0px 6px;
    gap: 2px;
    background-color: var(--bg-deep);
}

.topbar-btn {
    width: 28px;
    height: 28px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms linear;
}

.topbar-btn:hover {
    background-color: var(--bg-hover);
}

.topbar-btn:disabled {
    opacity: 0.4;
}

.topbar-btn-active {
    background-color: var(--accent-dark);
}

.topbar-btn-active:hover {
    background-color: var(--accent-muted);
}

.topbar-sep {
    width: 1px;
    height: 18px;
    background-color: var(--hairline);
}

.topbar-spacer {
    width: grow;
}

.workspace-tabs {
    flex-direction: row;
    align-items: center;
    height: 100%;
    gap: 2px;
    padding: 0px 4px;
}

.workspace-tab {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    min-height: 26px;
    padding: 0px 12px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    border-radius: 4px;
    transition: 60ms linear;
}

.workspace-tab:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.workspace-tab-active {
    background-color: var(--bg-panel);
    color: var(--text-bright);
}

.dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
    padding: 0px 2px 2px 2px;
    background-color: var(--bg-deep);
}

.viewport-root {
    width: grow;
    height: grow;
    flex-direction: column;
}

.viewport-canvas-layer {
    font-family: mono;
    font-size: 12px;
}

.game-root {
    width: grow;
    height: grow;
    flex-direction: column;
}

.game-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 32px;
    padding: 0px 6px;
    gap: 2px;
    background-color: var(--bg-base);
}

.game-toolbar-spacer {
    width: grow;
}

.game-camera {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.game-stage {
    width: grow;
    height: grow;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-deep);
    border-width: 1px;
    border-color: transparent;
}

.game-stage-focused {
    border-color: var(--accent);
}

.game-image {
    width: grow;
    height: grow;
    flex-grow: 1;
}

.game-message {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    padding: 12px;
}

.build-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-base);
}

.build-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 36px;
    padding: 0px 14px;
    gap: 8px;
    overflow: hidden;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.build-header-icon {
    width: 16px;
    height: 16px;
}

.build-title {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
}

.build-project {
    width: grow;
    min-width: 0px;
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.build-body {
    flex-direction: column;
    width: 100%;
    height: grow;
    min-height: 0px;
    padding: 12px 14px;
    gap: 10px;
    overflow: hidden;
}

.build-settings {
    flex-direction: column;
    width: 100%;
}

.build-form {
    flex-direction: column;
    width: 100%;
    gap: 6px;
}

.build-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 20px;
    gap: 10px;
}

.build-row-top {
    align-items: start;
}

.build-row-label {
    width: 110px;
    min-width: 110px;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    text-align: right;
}

.build-field {
    width: grow;
    min-width: 0px;
}

.build-size {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.build-size-field {
    width: grow;
    min-width: 0px;
}

.build-size-times {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.build-template {
    flex-direction: column;
    gap: 2px;
}

.build-template-state {
    width: 100%;
    font-family: regular;
    font-size: 12px;
    color: var(--text);
}

.build-template-found {
    color: var(--success);
}

.build-template-missing {
    color: #c9a24a;
}

.build-template-path {
    width: 100%;
    font-size: 12px;
    color: var(--text-dim);
}

.build-log-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 12px;
    padding: 4px 0px 0px 0px;
}

.build-log-title {
    width: grow;
    min-width: 0px;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
}

.build-status {
    max-width: 70%;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    text-align: right;
}

.build-status-busy {
    color: var(--text);
}

.build-status-error {
    color: var(--danger);
}

.build-status-success {
    color: var(--success);
}

.build-log-frame {
    flex-direction: column;
    width: 100%;
    height: grow;
    min-height: 60px;
    overflow: hidden;
    background-color: var(--bg-deep);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 4px;
}

.build-log {
    width: 100%;
    height: grow;
    padding: 6px 12px 6px 8px;
}

.build-log-text {
    font-size: 13px;
}

.build-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    min-height: 46px;
    padding: 8px 14px;
    gap: 8px;
    overflow: hidden;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.build-footer-spacer {
    width: grow;
    height: 1px;
    min-width: 0px;
}

.build-btn {
    padding: 6px 16px;
    background-color: var(--bg-widget);
    color: var(--text);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.build-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.build-btn:pressed {
    background-color: var(--bg-surface);
}

.build-btn:disabled {
    opacity: 0.4;
}

.build-browse {
    padding: 4px 6px;
}

.build-primary {
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
    border-width: 1px;
}

.build-primary:hover {
    background-color: var(--accent-muted);
}

.build-primary:pressed {
    background-color: var(--accent-press);
}

.asset-inspector-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    overflow: clip;
}

.asset-inspector-scroll {
    width: 100%;
}

.asset-inspector {
    flex-direction: column;
    width: 100%;
    padding: 10px;
    gap: 6px;
}

.asset-inspector-preview {
    width: 96px;
    height: 96px;
    color: #ffffff;
    border-radius: 4px;
}

.asset-inspector-title {
    font-family: medium;
    font-size: 13px;
    color: var(--text-bright);
}

.asset-inspector-path {
    font-family: mono;
    font-size: 11px;
    color: var(--text-muted);
}

.play-tint {
    background-color: var(--play-tint);
}
