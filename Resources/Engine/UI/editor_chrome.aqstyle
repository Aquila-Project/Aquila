#toolbar {
    width: 100%;
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-deep);
    padding: 0px 6px;
    gap: 0px;
}

#toolbar-left {
    flex-direction: row;
    align-items: center;
    gap: 0px;
    width: grow;
}

#engine-logo {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
    padding: 4px 10px;
}

#image-logo {
    width: 32px;
    height: 32px;
}

@media (max-width: 500px) {
    #toolbar {
        min-height: 36px;
        padding: 0px 4px;
    }

    #engine-logo {
        padding: 3px 6px;
        font-size: 14px;
    }
}

.card {
    flex-direction: column;
    width: 100%;
    height: grow;
    min-height: 0px;
    background-color: var(--bg-base);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
    overflow: hidden;
}

.card-console {
    width: 60vw;
    height: 260px;
}

.card-header {
    min-height: 30px;
    padding: 0px 4px 0px 2px;
    background-color: transparent;
}

.card-title {
    background-color: transparent;
    font-size: 13px;
    color: var(--text-bright);
    padding: 0px 6px;
}

.card-content {
    height: grow;
    min-height: 0px;
    padding: 2px 6px 6px 6px;
    gap: 4px;
    background-color: transparent;
    border-width: 0px;
}

.hud-round {
    width: 32px;
    height: 32px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-deep);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
}

.hud-round:hover {
    background-color: var(--bg-hover);
}

.hud-round:pressed {
    background-color: var(--bg-surface);
}

.component {
    flex-direction: column;
    width: 100%;
    background-color: var(--bg-muted);
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: 6px;
    overflow: hidden;
}

.component-header {
    min-height: 28px;
    padding: 0px 2px 0px 2px;
    background-color: transparent;
}

.component-title {
    background-color: transparent;
    font-size: 13px;
    color: var(--text-bright);
    padding: 0px 6px;
}

.component-content {
    padding: 2px 8px 8px 8px;
    gap: 6px;
    background-color: transparent;
    border-width: 0px;
}
