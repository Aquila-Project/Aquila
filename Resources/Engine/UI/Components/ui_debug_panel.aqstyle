.ui-debug-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.ui-debug-window {
    width: 380px;
    height: 480px;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 2px;
    overflow: hidden;
}

.ui-debug-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 30px;
    padding: 0px 10px;
    gap: 8px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-title {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.ui-debug-refresh {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    padding: 3px 10px;
    border-radius: 2px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.ui-debug-refresh:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.ui-debug-body {
    width: 100%;
    height: grow;
}

.ui-debug-tree-host {
    flex-direction: column;
    width: 100%;
    padding: 4px;
}

.ui-debug-tree-pane {
    width: 100%;
    height: grow;
}

.ui-debug-detail-pane {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-details {
    flex-direction: column;
    width: 100%;
    padding: 6px 8px;
    gap: 2px;
}

.ui-debug-section {
    font-family: regular;
    font-size: 14px;
    color: var(--accent-muted);
    width: 100%;
    padding: 6px 0px 2px 0px;
}

.ui-debug-row {
    flex-direction: row;
    width: 100%;
    gap: 8px;
}

.ui-debug-key {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 110px;
}

.ui-debug-val {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    flex-grow: 1;
}
