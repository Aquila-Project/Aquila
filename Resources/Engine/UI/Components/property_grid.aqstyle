.property-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 8px;
}

.property-label {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    width: 84px;
}

.property-row-stacked {
    flex-direction: column;
    align-items: start;
    width: 100%;
    gap: 3px;
}

.property-label-stacked {
    width: grow;
}

.property-separator {
    width: 100%;
    height: 1px;
    background-color: var(--hairline);
}

.property-split-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 20px;
    gap: 8px;
}

.property-split-row-top {
    align-items: start;
}

.property-split-label {
    width: 38%;
    min-height: 20px;
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    text-align: right;
}

.property-split-value {
    width: grow;
    min-width: 0px;
}

.property-split-check-text {
    width: grow;
    font-family: regular;
    font-size: 12px;
    color: var(--text);
}
