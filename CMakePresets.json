{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/Toolchain.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },

        {
            "name": "editor-debug",
            "displayName": "Editor | Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-release",
            "displayName": "Editor | Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-relwithdebinfo",
            "displayName": "Editor | RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-shipping",
            "displayName": "Editor | Shipping",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON",
                "AQUILA_SHIPPING": "ON"
            }
        },

        {
            "name": "engine-debug",
            "displayName": "Engine | Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-release",
            "displayName": "Engine | Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-relwithdebinfo",
            "displayName": "Engine | RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },

        {
            "name": "editor-debug-gcc",
            "displayName": "Editor | Debug | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-release-gcc",
            "displayName": "Editor | Release | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "engine-debug-gcc",
            "displayName": "Engine | Debug | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-release-gcc",
            "displayName": "Engine | Release | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "editor-debug",
            "configurePreset": "editor-debug",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-release",
            "configurePreset": "editor-release",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-relwithdebinfo",
            "configurePreset": "editor-relwithdebinfo",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-shipping",
            "configurePreset": "editor-shipping",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-shipping-package",
            "configurePreset": "editor-shipping",
            "targets": ["Package"]
        },
        {
            "name": "engine-debug",
            "configurePreset": "engine-debug",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-release",
            "configurePreset": "engine-release",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-relwithdebinfo",
            "configurePreset": "engine-relwithdebinfo",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "editor-debug-gcc",
            "configurePreset": "editor-debug-gcc",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-release-gcc",
            "configurePreset": "editor-release-gcc",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "engine-debug-gcc",
            "configurePreset": "engine-debug-gcc",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-release-gcc",
            "configurePreset": "engine-release-gcc",
            "targets": ["AquilaEngine"]
        }
    ],

    "workflowPresets": [
        {
            "name": "editor-shipping",
            "steps": [
                { "type": "configure", "name": "editor-shipping" },
                { "type": "build", "name": "editor-shipping-package" }
            ]
        }
    ]
}
