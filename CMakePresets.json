{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/Toolchain.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },

        {
            "name": "editor-debug",
            "displayName": "Editor | Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-release",
            "displayName": "Editor | Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-relwithdebinfo",
            "displayName": "Editor | RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-shipping",
            "displayName": "Editor | Shipping",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON",
                "AQUILA_SHIPPING": "ON"
            }
        },

        {
            "name": "engine-debug",
            "displayName": "Engine | Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-release",
            "displayName": "Engine | Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-relwithdebinfo",
            "displayName": "Engine | RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },

        {
            "name": "editor-debug-gcc",
            "displayName": "Editor | Debug | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "editor-release-gcc",
            "displayName": "Editor | Release | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "engine-debug-gcc",
            "displayName": "Engine | Debug | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "engine-release-gcc",
            "displayName": "Engine | Release | GCC",
            "inherits": "gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AQUILA_BUILD_EDITOR": "OFF"
            }
        },

        {
            "name": "checks",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AQUILA_BUILD_EDITOR": "ON",
                "AQUILA_SHARED_ENGINE": "OFF"
            }
        },
        {
            "name": "editor-asan",
            "displayName": "Editor | Debug | ASan + UBSan",
            "inherits": "checks",
            "cacheVariables": {
                "AQUILA_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "engine-tsan",
            "displayName": "Engine | Debug | TSan (CPU tests only)",
            "inherits": "checks",
            "cacheVariables": {
                "AQUILA_BUILD_EDITOR": "OFF",
                "AQUILA_SANITIZERS": "thread",
                "AQUILA_LINT_UI": "OFF"
            }
        },
        {
            "name": "editor-coverage",
            "displayName": "Editor | Debug | Coverage",
            "inherits": "checks",
            "cacheVariables": {
                "AQUILA_COVERAGE": "ON"
            }
        },
        {
            "name": "editor-tidy",
            "displayName": "Editor | Debug | clang-tidy",
            "inherits": "checks",
            "cacheVariables": {
                "AQUILA_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "engine-fuzz",
            "displayName": "Engine | RelWithDebInfo | libFuzzer + ASan + UBSan",
            "inherits": "checks",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "AQUILA_BUILD_EDITOR": "OFF",
                "AQUILA_SANITIZERS": "address;undefined",
                "AQUILA_FUZZ": "ON",
                "AQUILA_LINT_UI": "OFF"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "editor-debug",
            "configurePreset": "editor-debug",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-release",
            "configurePreset": "editor-release",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-relwithdebinfo",
            "configurePreset": "editor-relwithdebinfo",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-shipping",
            "configurePreset": "editor-shipping",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-shipping-package",
            "configurePreset": "editor-shipping",
            "targets": ["Package"]
        },
        {
            "name": "engine-debug",
            "configurePreset": "engine-debug",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-release",
            "configurePreset": "engine-release",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-relwithdebinfo",
            "configurePreset": "engine-relwithdebinfo",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "editor-debug-gcc",
            "configurePreset": "editor-debug-gcc",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "editor-release-gcc",
            "configurePreset": "editor-release-gcc",
            "targets": ["AquilaEditor"]
        },
        {
            "name": "engine-debug-gcc",
            "configurePreset": "engine-debug-gcc",
            "targets": ["AquilaEngine"]
        },
        {
            "name": "engine-release-gcc",
            "configurePreset": "engine-release-gcc",
            "targets": ["AquilaEngine"]
        },

        {
            "name": "editor-asan",
            "configurePreset": "editor-asan"
        },
        {
            "name": "engine-tsan",
            "configurePreset": "engine-tsan",
            "targets": ["FoundationTests", "PlatformTests", "SceneTests", "ScriptingTests", "PlayerTests"]
        },
        {
            "name": "editor-coverage",
            "configurePreset": "editor-coverage",
            "targets": ["Coverage"]
        },
        {
            "name": "editor-tidy",
            "configurePreset": "editor-tidy",
            "targets": ["AquilaEditor", "AquilaEngine", "AquilaPlayer"]
        },
        {
            "name": "engine-fuzz",
            "configurePreset": "engine-fuzz",
            "targets": ["Fuzzers"]
        }
    ],

    "testPresets": [
        {
            "name": "editor-debug",
            "configurePreset": "editor-debug",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "engine-debug",
            "configurePreset": "engine-debug",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "editor-asan",
            "configurePreset": "editor-asan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "engine-tsan",
            "configurePreset": "engine-tsan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" },
            "filter": { "exclude": { "name": "^(RHITests|UITests)$" } }
        },
        {
            "name": "editor-coverage",
            "configurePreset": "editor-coverage",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "engine-fuzz",
            "configurePreset": "engine-fuzz",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        }
    ],

    "workflowPresets": [
        {
            "name": "editor-shipping",
            "steps": [
                { "type": "configure", "name": "editor-shipping" },
                { "type": "build", "name": "editor-shipping-package" }
            ]
        }
    ]
}
